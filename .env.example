# Foundry Multi-Network Deployment .env Example
# Fill in your private keys and RPC URLs for each network

BASE_RPC_URL=
BASE_PRIVATE_KEY=

# Sentry DSN for frontend error logging
SENTRY_DSN=your_sentry_dsn_here

# Tenderly credentials for smart contract monitoring (Foundry integration)
TENDERLY_PROJECT=your_tenderly_project
TENDERLY_USERNAME=your_tenderly_username
TENDERLY_ACCESS_KEY=your_tenderly_access_key
# WalletConnect project ID (optional; enables the WalletConnect option in the wallet modal)
VITE_WALLETCONNECT_PROJECT_ID=

# Arc testnet (Deposit Passport, RentDepositVaultV2)
ARC_RPC_URL=https://rpc.testnet.arc.network
VAULT_V2_ADDRESS=0xa79059db1cD0f5220959B484B89993b04b0E7578
# Private key of the approver (World backend signer). Server-side only, never commit a real value.
APPROVER_PRIVATE_KEY=
